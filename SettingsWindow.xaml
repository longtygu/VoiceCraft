<Window x:Class="VoiceCraft.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt VoiceCraft" Height="690" Width="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Background="{Binding WindowGlassBrush, FallbackValue=#F2101622}" CornerRadius="6"
            BorderThickness="1.2" BorderBrush="{Binding WindowBorderBrush, FallbackValue=#880078D4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <!-- THANH TIEU DE CAI DAT -->
            <Border Grid.Row="0" Background="#28000000" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="⚙ CÀI ĐẶT HỆ THỐNG, MODEL VÀ CẬP NHẬT" Foreground="White"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Content="✕" Width="44" HorizontalAlignment="Right" Style="{StaticResource Win10CloseBtn}" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- NOI DUNG CAI DAT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,12,14,8" Padding="0,0,6,0">
                <StackPanel>
                    <!-- TAB 1: GIAO DIEN VA MAU SAC (CO MAU DEN VA XAM) -->
                    <Border Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="4" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="1. GIAO DIỆN VÀ MÀU SẮC STUDIO (ĐEN / XÁM / AERO)" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}"
                                       FontWeight="Bold" FontSize="11.5" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Chủ đề nền kính:" Foreground="#E6F2FF" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AeroThemes}" SelectedItem="{Binding SelectedAeroTheme}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Màu nhấn chủ đạo (Accent):" Foreground="#E6F2FF" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AccentColorList}" SelectedItem="{Binding SelectedAccentItem}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Màu sóng âm (Waveform):" Foreground="#E6F2FF" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding WaveformColorList}" SelectedItem="{Binding SelectedWaveformColorItem}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Màu vạch phụ (Hover Line):" Foreground="#E6F2FF" FontSize="11.5" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding SecondaryLineColorList}" SelectedItem="{Binding SelectedSecondaryLineColorItem}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Độ trong suốt nền cữa sổ:" Foreground="#D8ECFF" FontSize="11.5"/>
                                <TextBlock Text="{Binding GlassOpacityPercent}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="0.25" Maximum="1.0" Value="{Binding GlassOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Độ đậm khung thẻ Panel:" Foreground="#D8ECFF" FontSize="11.5"/>
                                <TextBlock Text="{Binding CardOpacityPercent}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider Minimum="0.15" Maximum="0.95" Value="{Binding CardOpacity}" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                            <CheckBox Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding ShowAeroReflection}"
                                      Content="Hiển thị lớp phản chiếu kính Aero Glass" Margin="0,0,0,6"/>
                            <CheckBox Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding AutoPlayAudio}"
                                      Content="Tự động phát âm thanh ngay sau khi tổng hợp"/>
                        </StackPanel>
                    </Border>

                    <!-- TAB 2 (TACH RIENG): SUA LOI VA QUET MODEL AI TU DONG -->
                    <Border Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="4" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#4400E5FF" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="2. SửA LỖI VÀ QUÉT MODEL AI TỰ ĐỘNG" Foreground="#00E5FF"
                                               FontWeight="Bold" FontSize="11.5" Margin="0,0,0,3"/>
                                    <TextBlock Text="Tự động quét lỗi, tải bổ sung Model thiếu và khôi phục kết nối TTS Engine."
                                               Foreground="#B8E8FF" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔧 Sửa và Quét lỗi Model" Command="{Binding RepairAndDownloadModelsCommand}"
                                        Style="{StaticResource FlatPrimaryBtn}" Height="34" Padding="14,4" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- KHUNG TRANG THAI VA TIEN TRINH CHI TIET (CHI HIEN KHI BAM NUT SUA VA CO NUT AN DI) -->
                            <Border Background="#38040A14" BorderBrush="#4500E676" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,0"
                                    Visibility="{Binding ModelRepairVisibility, FallbackValue=Collapsed}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ModelRepairStatusText}" Foreground="#00E676"
                                                   FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="1" Content="▲ Ẩn trạng thái" Command="{Binding HideRepairPanelCommand}"
                                                Style="{StaticResource MiniChipBtn}" Padding="8,2" Margin="8,0,0,0"/>
                                    </Grid>

                                    <Grid Height="16" Margin="0,0,0,8">
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ModelRepairProgress}"
                                                     Background="#33000000" Foreground="#00E676" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                        <TextBlock Text="{Binding ModelRepairProgressPercent}" Foreground="White" FontWeight="Bold"
                                                   FontFamily="Consolas" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="Chi tiết từng tiến trình:" Foreground="#90B4D4" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <Border Background="#55000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="3" Padding="6">
                                        <TextBox Text="{Binding ModelRepairDetailLog, Mode=OneWay}" IsReadOnly="True"
                                                 Height="95" Background="Transparent" Foreground="#D8F8E8" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- TAB 3: QUAN LY THU MUC VA DON DEP HE THONG -->
                    <Border Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="4" Padding="14" Margin="0,0,0,12"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="3. QUẢN LÝ THƯ MỤC VÀ DỌN DẸP HỆ THỐNG" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}"
                                       FontWeight="Bold" FontSize="11.5" Margin="0,0,0,8"/>

                            <UniformGrid Rows="1" Columns="3">
                                <Button Content="🗑️ Dọn dẹp Output" Command="{Binding ClearCacheCommand}"
                                        Style="{StaticResource FlatGlassBtn}" Height="34" Margin="0,0,4,0"/>
                                <Button Content="📂 Thư mục Models" Command="{Binding OpenFolderCommand}" CommandParameter="Models"
                                        Style="{StaticResource FlatGlassBtn}" Height="34" Margin="2,0,2,0"/>
                                <Button Content="🔄 Khởi động lại Engine" Command="{Binding RestartEngineCommand}"
                                        Style="{StaticResource FlatGlassBtn}" Height="34" Margin="4,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- TAB 4: CAP NHAT TRUC TIEP TU GITHUB (KHOA CUNG DUONG DAN - CHI CHO SAO CHEP) -->
                    <Border Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="4" Padding="14"
                            BorderBrush="#30FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="4. CẬP NHẬT TỰ ĐỘNG GITHUB (KHOÁ CỨNG NGUỒN CHÍNH THỨC)" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}"
                                       FontWeight="Bold" FontSize="11.5" Margin="0,0,0,8"/>

                            <TextBlock Text="Đường dẫn GitHub chính thức (Chỉ cho phép sao chép):" Foreground="#D8ECFF" FontSize="11.5" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GitHubRepo, Mode=OneWay}"
                                         IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                         Height="30" Background="#25060C14" Foreground="#90E0FF"
                                         BorderBrush="#4500B4FF" BorderThickness="1"
                                         Padding="8,5" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Content="📋 Sao chép" Command="{Binding CopyGitHubRepoCommand}"
                                        Style="{StaticResource FlatGlassBtn}" Height="30" Padding="12,4" Margin="6,0,0,0"/>
                            </Grid>

                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="#FFD600" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <Grid Height="18" Margin="0,0,0,8" Visibility="{Binding UpdateProgressVisibility, FallbackValue=Collapsed}">
                                <ProgressBar Value="{Binding UpdateProgress}" Minimum="0" Maximum="100" Background="#33000000" Foreground="#00E5FF"/>
                                <TextBlock Text="{Binding UpdateProgressPercent}" Foreground="White" FontWeight="Bold" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="#30000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10" MaxHeight="85">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding UpdateChangelog}" Foreground="#C8E0F8" FontSize="11" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>

                            <UniformGrid Rows="1" Columns="2">
                                <Button Content="🔍 Kiểm tra cập nhật" Command="{Binding CheckUpdateCommand}"
                                        Style="{StaticResource FlatGlassBtn}" Height="34" Margin="0,0,5,0"/>
                                <Button Content="⚡ Cập nhật và Khởi động lại" Command="{Binding DownloadUpdateCommand}"
                                        Style="{StaticResource FlatPrimaryBtn}" Height="34" Margin="5,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- CHAN CUA SO CAI DAT -->
            <Border Grid.Row="2" Background="#24000000" BorderBrush="#28FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6" Padding="14,8">
                <Button Content="Đóng Cài đặt" Width="120" Height="32" HorizontalAlignment="Right" Style="{StaticResource FlatPrimaryBtn}" Click="Close_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>