<Window x:Class="VoiceCraft.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceCraft - Cài đặt &amp; Cập nhật" Height="760" Width="1040"
        MinHeight="680" MinWidth="960"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Border Background="{Binding WindowGlassBrush, FallbackValue=#D912161F}" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding WindowBorderBrush, FallbackValue=#550078D4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Polygon Grid.Row="0" Grid.RowSpan="2" Points="0,0 480,0 260,760 0,760" IsHitTestVisible="False"
                     Visibility="{Binding AeroReflectionVisibility, FallbackValue=Visible}">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>
            
            <Border Grid.Row="0" Background="#24000000" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="⚙️ Cài đặt hệ thống, Sửa lỗi Model &amp; Giao diện VoiceCraft" Foreground="White" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center"/>
                        <Border Background="#20FFFFFF" CornerRadius="3" Padding="10,2" Margin="14,0,0,0" BorderBrush="#28FFFFFF" BorderThickness="1">
                            <TextBlock Text="{Binding AppVersion, StringFormat={}v{0}, FallbackValue=v1.0.4}" Foreground="#D8ECFF" FontSize="11.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <Button Content="✕" Width="48" HorizontalAlignment="Right" Style="{StaticResource Win10CloseBtn}" Click="Close_Click"/>
                </Grid>
            </Border>
            
            <Grid Grid.Row="1" Margin="18,16,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.24*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="5" Padding="18,16" BorderBrush="#30FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="🎨 TUỲ CHỈNH MÀU SẮC &amp; GIAO DIỆN" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="13" Margin="0,0,0,14"/>
                            <TextBlock Text="1. Tông màu nền kính (Glass Tint):" Foreground="#E6F2FF" FontSize="12.5" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AeroThemes}" SelectedItem="{Binding SelectedAeroTheme}" Height="34" Margin="0,0,0,14"/>
                            <TextBlock Text="2. Màu nhấn chủ đạo (Accent Color):" Foreground="#E6F2FF" FontSize="12.5" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding AccentColorList}" SelectedItem="{Binding SelectedAccentItem}" Height="34" Margin="0,0,0,14"/>
                            <TextBlock Text="3. Màu sóng âm thanh (Waveform):" Foreground="#E6F2FF" FontSize="12.5" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding WaveformColorList}" SelectedItem="{Binding SelectedWaveformColorItem}" Height="34" Margin="0,0,0,14"/>
                            <TextBlock Text="4. Màu vạch phụ tương tác (Cursor):" Foreground="#E6F2FF" FontSize="12.5" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding SecondaryLineColorList}" SelectedItem="{Binding SelectedSecondaryLineColorItem}" Height="34" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="5. Độ trong suốt cửa sổ chính:" Foreground="#E6F2FF" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" Text="{Binding GlassOpacityPercent}" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="12.5"/>
                            </Grid>
                            <Slider Minimum="0.25" Maximum="1.0" Value="{Binding GlassOpacity}" TickFrequency="0.05" Margin="0,0,0,14"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="6. Độ trong suốt khung panel:" Foreground="#E6F2FF" FontSize="12.5"/>
                                <TextBlock Grid.Column="1" Text="{Binding CardOpacityPercent}" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="12.5"/>
                            </Grid>
                            <Slider Minimum="0.15" Maximum="0.95" Value="{Binding CardOpacity}" TickFrequency="0.05" Margin="0,0,0,16"/>
                            <CheckBox IsChecked="{Binding ShowAeroReflection}" Content="Bật lớp phản chiếu gương chéo Win7" Margin="0,2,0,10"/>
                            <CheckBox IsChecked="{Binding AutoPlayAudio}" Content="Tự động phát âm thanh sau khi tạo xong" Margin="0,0,0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                
                <Border Grid.Column="1" Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="5" Padding="18,16" BorderBrush="#30FFFFFF" BorderThickness="1" Margin="10,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ 1. QUẢN LÝ ENGINE &amp; DỌN DẸP OUTPUT" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2" Rows="2" Height="82" Margin="0,0,0,14">
                                <Button Content="🔄 Khởi động lại Engine" Command="{Binding RestartEngineCommand}" Style="{StaticResource FlatGlassBtn}" Margin="0,0,6,8"/>
                                <Button Content="🗑️ Dọn dẹp Output (.wav)" Command="{Binding ClearCacheCommand}" Style="{StaticResource FlatGlassBtn}" Margin="6,0,0,8"/>
                                <Button Content="📂 Mở thư mục Models" Command="{Binding OpenFolderCommand}" CommandParameter="Models" Style="{StaticResource FlatGlassBtn}" Margin="0,0,6,0"/>
                                <Button Content="📂 Mở thư mục Output" Command="{Binding OpenFolderCommand}" CommandParameter="Output" Style="{StaticResource FlatGlassBtn}" Margin="6,0,0,0"/>
                            </UniformGrid>
                            
                            <Border Background="#280A1828" BorderBrush="#4400E5FF" BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📦 2. SỬA LỖI &amp; QUÉT MODEL AI" Foreground="#00E5FF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="{Binding RepairDrawerToggleButtonText}"
                                                Command="{Binding ToggleRepairDrawerCommand}"
                                                Style="{StaticResource MiniChipBtn}" Height="28" Padding="12,3"
                                                ToolTip="Thu gọn hoặc mở rộng khung chi tiết tiến trình sửa lỗi Model"/>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tự động kiểm tra và tải bổ sung các file Model AI còn thiếu:"
                                                   Foreground="#B8D8F8" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <Button Grid.Column="1" Content="🔧 Sửa &amp; Quét lỗi Model" Command="{Binding RepairAndDownloadModelsCommand}"
                                                Style="{StaticResource FlatPrimaryBtn}" Height="32" Padding="14,4" FontSize="12"
                                                ToolTip="Bắt đầu quét kiểm tra và tự động tải/sửa các file Model AI"/>
                                    </Grid>
                                    
                                    <StackPanel Visibility="{Binding ModelRepairDrawerVisibility, FallbackValue=Collapsed}" Margin="0,12,0,0">
                                        <Separator Background="#28FFFFFF" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,8">
                                            <ProgressBar Value="{Binding ModelRepairProgress}" Maximum="100" Height="18" Background="#33000000" Foreground="#00E676" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                                            <TextBlock Text="{Binding ModelRepairProgressPercent}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Chi tiết từng tiến trình quét &amp; sửa lỗi Model:" Foreground="#B0C8E0" FontSize="11.5" Margin="0,0,0,5"/>
                                        <Border Background="#45040810" CornerRadius="4" Height="130" Padding="10,8" BorderBrush="#28FFFFFF" BorderThickness="1">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding ModelRepairLogText}" Foreground="#D8ECFF" FontSize="11.5" LineHeight="18" TextWrapping="Wrap" FontFamily="Consolas"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            
                            <Border Background="#20081220" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="5" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="🚀 3. CẬP NHẬT PHẦN MỀM (GITHUB RELEASES)" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="12.5" Margin="0,0,0,8"/>
                                    <TextBlock Text="Đường dẫn GitHub Repo (Đã khóa cố định - Chỉ cho phép sao chép):" Foreground="#D0E8FF" FontSize="11.5" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding GitHubRepo, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                                 Height="32" Background="#25060C14" Foreground="#90E0FF" BorderBrush="#4500B4FF" BorderThickness="1"
                                                 Padding="10,5" FontSize="12" FontFamily="Consolas" VerticalContentAlignment="Center"
                                                 ToolTip="Đường dẫn kho lưu trữ chính thức đã được khóa cứng (Chỉ cho phép bôi đen &amp; sao chép)"/>
                                        <Button Grid.Column="1" Content="📋 Sao chép" Command="{Binding CopyGitHubRepoCommand}"
                                                Style="{StaticResource FlatGlassBtn}" Height="32" Padding="14,4" Margin="8,0,0,0"
                                                ToolTip="Sao chép đường dẫn GitHub vào Clipboard"/>
                                    </Grid>
                                    <UniformGrid Columns="3" Rows="1" Height="34" Margin="0,0,0,10">
                                        <Button Content="🔍 Kiểm tra cập nhật" Command="{Binding CheckUpdateCommand}" Style="{StaticResource FlatPrimaryBtn}" Margin="0,0,5,0" FontSize="12"/>
                                        <Button Content="⚡ Tải &amp; Cài bản mới" Command="{Binding DownloadUpdateCommand}" Style="{StaticResource FlatGlassBtn}" Margin="3,0,3,0" FontSize="12"/>
                                        <Button Content="📂 Thư mục Updates" Command="{Binding OpenFolderCommand}" CommandParameter="Updates" Style="{StaticResource FlatGlassBtn}" Margin="5,0,0,0" FontSize="12"/>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding UpdateStatusText}" Foreground="#E0F2FE" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <Grid Visibility="{Binding UpdateProgressVisibility}" Margin="0,0,0,8">
                                        <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="16" Background="#33000000" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                                        <TextBlock Text="{Binding UpdateProgressPercent}" Foreground="White" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Nội dung bản phát hành (Changelog):" Foreground="#B0C8E0" FontSize="11.5" Margin="0,0,0,4"/>
                                    <Border Background="#40060C14" CornerRadius="4" Height="78" Padding="8,6" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding UpdateChangelog}" Foreground="#D8ECFF" FontSize="11.5" TextWrapping="Wrap" FontFamily="Consolas"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>