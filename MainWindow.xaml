<Window x:Class="VoiceCraft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoiceCraft.App_Core.ViewModels"
        Title="VoiceCraft" Height="800" Width="1260"
        MinHeight="720" MinWidth="1120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Border Background="{Binding WindowGlassBrush, FallbackValue=#D912161F}" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding WindowBorderBrush, FallbackValue=#550078D4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- LỚP KÍNH PHẢN CHIẾU MỜ KIỂU WINDOWS 7 -->
            <Polygon Grid.Row="0" Grid.RowSpan="3" Points="0,0 600,0 340,800 0,800" IsHitTestVisible="False"
                     Visibility="{Binding AeroReflectionVisibility, FallbackValue=Visible}">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>

            <!-- ==================== THANH TIÊU ĐỀ PHẲNG WINDOWS 10 ==================== -->
            <Border Grid.Row="0" Background="#24000000" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="{Binding ConnectionColor, FallbackValue=#00E676}" Margin="0,0,10,0"/>
                        <TextBlock Text="VoiceCraft" Foreground="White" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AppVersion, StringFormat={}v{0}, FallbackValue=v1.0.4}" Foreground="#90B4D4" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,2,0,0"/>

                        <!-- THANH TRẠNG THÁI MỞ RỘNG: CHỈ HIỆN POPUP KHI BÁO LỖI ĐỎ NHẤP NHÁY -->
                        <Border x:Name="StatusBadgeBorder" CornerRadius="4" Padding="20,5" MinWidth="168" Margin="16,0,0,0"
                                Background="{Binding StatusBadgeBackground, FallbackValue=#3800C853}"
                                BorderBrush="{Binding StatusBadgeBorder, FallbackValue=#AA00E676}"
                                BorderThickness="1.2"
                                ToolTipService.IsEnabled="{Binding IsModelError, FallbackValue=False}"
                                ToolTipService.InitialShowDelay="60" ToolTipService.ShowDuration="20000"
                                ToolTip="thử tải lại và sửa lỗi model trong cài đặt">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelError}" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF1744" BlurRadius="18" ShadowDepth="0" Opacity="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.45"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       Foreground="{Binding StatusTextForeground, FallbackValue=#E8FFF0}"
                                       FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button Content="🎚️ Mini Studio" Padding="12,0" FontSize="12.5" FontWeight="SemiBold" Foreground="#00E5FF"
                                ToolTip="Mở cửa sổ Mini Studio riêng (Cắt • Ghép Kéo-Thả • Chỉnh Tone • Nhái giọng • 5-Band EQ)"
                                Style="{StaticResource Win10TitleBtn}" Click="OpenMiniStudio_Click"
                                IsEnabled="{Binding IsControlsEnabled, FallbackValue=True}"/>
                        <Rectangle Width="1" Height="18" Fill="#28FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Content="⚙" Width="44" FontSize="15" ToolTip="Cài đặt, Sửa lỗi Model &amp; Cập nhật"
                                Style="{StaticResource Win10TitleBtn}" Click="OpenSettings_Click"
                                IsEnabled="{Binding IsControlsEnabled, FallbackValue=True}"/>
                        <Rectangle Width="1" Height="18" Fill="#28FFFFFF" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Content="─" Width="46" Style="{StaticResource Win10TitleBtn}" Click="Minimize_Click"/>
                        <Button Content="☐" Width="46" Style="{StaticResource Win10TitleBtn}" Click="Maximize_Click"/>
                        <Button Content="✕" Width="48" Style="{StaticResource Win10CloseBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== GIAO DIỆN PHÒNG THU CHÍNH ==================== -->
            <Grid Grid.Row="1" Margin="14,12,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="435"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PANEL TRÁI: TAB 1 (MỞ) + TAB 2 & TAB 3 (THU GỌN MẶC ĐỊNH, MỞ RỘNG KHI GẠT BẬT) -->
                <Border Grid.Column="0" Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="5" Margin="0,0,12,0" Padding="16,14"
                        BorderBrush="#30FFFFFF" BorderThickness="1" IsEnabled="{Binding IsControlsEnabled, FallbackValue=True}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel>
                            <!-- TAB 1: CHỌN MODEL GIỌNG ĐỌC AI -->
                            <Border Background="#20081220" BorderBrush="#35FFFFFF" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎙️ 1. CHỌN MODEL GIỌNG ĐỌC AI" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="🔄 Quét lại" Command="{Binding RefreshModelsCommand}" Style="{StaticResource MiniChipBtn}" Padding="10,3"/>
                                    </Grid>

                                    <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModelFile}" Height="34" Margin="0,0,0,8"/>
                                    <Border Background="#2200C8FF" BorderBrush="#4400C8FF" BorderThickness="1" CornerRadius="4" Padding="9,6" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedModelInfoText}" Foreground="#B8E8FF" FontSize="11.5" TextWrapping="Wrap"/>
                                    </Border>

                                    <Grid Margin="0,0,0,10" Visibility="{Binding AutoModelOptionsVisibility, FallbackValue=Visible}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Vùng miền / Chế độ:" Foreground="#E6F2FF" FontSize="11.5" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Giới tính giọng:" Foreground="#E6F2FF" FontSize="11.5" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding SelectedGender}" Height="32" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Mã người nói (Speaker ID: -1 -> 903):" Foreground="#E6F2FF" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SpeakerIdDisplay}" Foreground="#FFD600" FontWeight="Bold" FontFamily="Consolas" FontSize="12.5"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="-1" Command="{Binding AdjustSpeakerIdCommand}" CommandParameter="-1" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                        <Slider Grid.Column="1" Minimum="-1" Maximum="903" Value="{Binding SpeakerId}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                        <Button Grid.Column="2" Content="+1" Command="{Binding AdjustSpeakerIdCommand}" CommandParameter="1" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                    </Grid>

                                    <CheckBox IsChecked="{Binding BilingualAuto}" Foreground="#D8ECFF" Margin="0,2,0,8"
                                              Content="Tự động xử lý từ Tiếng Anh trong câu"/>
                                    <CheckBox IsChecked="{Binding SingleVoiceMode}" Foreground="#00E676" Margin="0,0,0,2"
                                              Content="Giữ 1 giọng xuyên suốt (Phiên âm CMU 135k)"/>
                                </StackPanel>
                            </Border>

                            <!-- TAB 2: NHÁI GIỌNG AI (MẶC ĐỊNH THU GỌN) -->
                            <Border Background="#280A1828" BorderBrush="#4400E5FF" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🧬 2. NHÁI GIỌNG AI (VOICE CLONING)" Foreground="#00E5FF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsVoiceCloneEnabled}" Content="Bật" Foreground="#FFF59D" FontWeight="SemiBold"/>
                                    </Grid>

                                    <StackPanel Visibility="{Binding VoiceClonePanelVisibility, FallbackValue=Collapsed}" Margin="0,10,0,0">
                                        <Separator Background="#28FFFFFF" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding CloneReferenceFileName}" Foreground="#B8E8FF" FontSize="11.5" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📂 Chọn mẫu (.wav/.mp3)" Command="{Binding SelectCloneSampleCommand}" Style="{StaticResource MiniChipBtn}" Height="28" Margin="0,0,6,0"/>
                                            <Button Grid.Column="1" Content="▶ Nghe mẫu" Command="{Binding PreviewCloneSampleCommand}" Style="{StaticResource MiniChipBtn}" Height="28" Padding="10,2" Margin="0,0,6,0"/>
                                            <Button Grid.Column="2" Content="✕" Command="{Binding ClearCloneSampleCommand}" Style="{StaticResource MiniChipBtn}" Height="28" Width="30"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Độ khớp âm sắc &amp; cao độ mẫu (Strength):" Foreground="#D8ECFF" FontSize="11.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CloneStrengthPercent}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="12"/>
                                        </Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding CloneStrength}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- TAB 3: BỘ LỌC EQ THEO TỪNG MODEL (MẶC ĐỊNH THU GỌN) -->
                            <Border Background="#280D1420" BorderBrush="#38FFFFFF" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎛️ 3. BỘ LỌC EQ THEO TỪNG MODEL" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEqPanelExpanded}" Content="Mở" Foreground="#00E676" FontWeight="SemiBold"/>
                                    </Grid>

                                    <StackPanel Visibility="{Binding EqPanelVisibility, FallbackValue=Collapsed}" Margin="0,10,0,0">
                                        <Separator Background="#28FFFFFF" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsChecked="{Binding BypassDsp}" Foreground="#FFD600" FontWeight="SemiBold"
                                                      Content="Xuất âm thanh thô (Tắt DSP/EQ)"/>
                                            <Button Grid.Column="1" Content="↺ Mặc định EQ" Command="{Binding ResetEqCommand}" Style="{StaticResource MiniChipBtn}" Padding="8,3"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Độ ấm trầm (Bass 185Hz):" Foreground="#E6F2FF" FontSize="11.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EqBassDisplay}" Foreground="#00E676" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                        </Grid>
                                        <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding EqBassDb}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Độ sáng &amp; rõ chữ (Treble 3.4kHz):" Foreground="#E6F2FF" FontSize="11.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EqTrebleDisplay}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                        </Grid>
                                        <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding EqTrebleDb}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Lọc khử sôi nền (De-Hiss Cutoff):" Foreground="#E6F2FF" FontSize="11.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DeHissDisplay}" Foreground="#FFD600" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                        </Grid>
                                        <Slider Minimum="4500" Maximum="11500" Value="{Binding DeHissCutoff}" TickFrequency="250" IsSnapToTickEnabled="True" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Độ mượt nguyên âm VITS (Noise Scale):" Foreground="#E6F2FF" FontSize="11.5"/>
                                            <TextBlock Grid.Column="1" Text="{Binding VitsNoiseScale, StringFormat={}{0:0.00}}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                        </Grid>
                                        <Slider Minimum="0.20" Maximum="0.90" Value="{Binding VitsNoiseScale}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- PHẦN 4: TỐC ĐỘ (SPEED) & ĐỘ CAO (PITCH) -->
                            <Grid Margin="0,2,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tốc độ đọc (Speed):" Foreground="#E6F2FF" FontSize="12.5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#26FFFFFF" BorderBrush="{Binding AccentBrush, FallbackValue=#0078D4}" BorderThickness="1" CornerRadius="3" Padding="10,2">
                                    <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0#}x}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="12.5"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="-0.1" Command="{Binding AdjustSpeedCommand}" CommandParameter="-0.1" Style="{StaticResource MiniChipBtn}" Height="25" Padding="4,2"/>
                                <Slider Grid.Column="1" Minimum="0.25" Maximum="3.0" Value="{Binding Speed}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Grid.Column="2" Content="+0.1" Command="{Binding AdjustSpeedCommand}" CommandParameter="0.1" Style="{StaticResource MiniChipBtn}" Height="25" Padding="4,2"/>
                            </Grid>
                            <UniformGrid Rows="1" Columns="6" Margin="0,2,0,12">
                                <Button Content="0.8x" Command="{Binding SetSpeedPresetCommand}" CommandParameter="0.8" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.0x" Command="{Binding SetSpeedPresetCommand}" CommandParameter="1.0" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.1x" Command="{Binding SetSpeedPresetCommand}" CommandParameter="1.1" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.2x" Command="{Binding SetSpeedPresetCommand}" CommandParameter="1.2" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.5x" Command="{Binding SetSpeedPresetCommand}" CommandParameter="1.5" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="2.0x" Command="{Binding SetSpeedPresetCommand}" CommandParameter="2.0" Style="{StaticResource MiniChipBtn}" Height="25"/>
                            </UniformGrid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Độ cao giọng (Pitch):" Foreground="#E6F2FF" FontSize="12.5" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#26FFFFFF" BorderBrush="{Binding AccentBrush, FallbackValue=#0078D4}" BorderThickness="1" CornerRadius="3" Padding="10,2">
                                    <TextBlock Text="{Binding Pitch, StringFormat={}{0:0.0#}}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="12.5"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="-0.1" Command="{Binding AdjustPitchCommand}" CommandParameter="-0.1" Style="{StaticResource MiniChipBtn}" Height="25" Padding="4,2"/>
                                <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="{Binding Pitch}" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <Button Grid.Column="2" Content="+0.1" Command="{Binding AdjustPitchCommand}" CommandParameter="0.1" Style="{StaticResource MiniChipBtn}" Height="25" Padding="4,2"/>
                            </Grid>
                            <UniformGrid Rows="1" Columns="6" Margin="0,2,0,4">
                                <Button Content="0.8" Command="{Binding SetPitchPresetCommand}" CommandParameter="0.8" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="0.9" Command="{Binding SetPitchPresetCommand}" CommandParameter="0.9" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.0" Command="{Binding SetPitchPresetCommand}" CommandParameter="1.0" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.1" Command="{Binding SetPitchPresetCommand}" CommandParameter="1.1" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.2" Command="{Binding SetPitchPresetCommand}" CommandParameter="1.2" Style="{StaticResource MiniChipBtn}" Height="25"/>
                                <Button Content="1.4" Command="{Binding SetPitchPresetCommand}" CommandParameter="1.4" Style="{StaticResource MiniChipBtn}" Height="25"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- PANEL PHẢI: SOẠN THẢO VĂN BẢN (TTS) RỘNG RÃI + NÚT MỞ CỬA SỔ MINI STUDIO RIÊNG -->
                <Border Grid.Column="1" Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="5" Padding="16,14"
                        BorderBrush="#30FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📝 SOẠN THẢO VĂN BẢN" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Button Content="📋 Dán văn bản" Command="{Binding PasteTextCommand}" Style="{StaticResource MiniChipBtn}" Height="28" Padding="10,3" Margin="0,0,8,0"/>
                                <Button Content="🗑️ Xóa trắng" Command="{Binding ClearTextCommand}" Style="{StaticResource MiniChipBtn}" Height="28" Padding="10,3"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CharCount, StringFormat={}{0} / 5000}" VerticalAlignment="Center" Foreground="#B0C8E0" FontSize="12.5" Margin="0,0,12,0"/>
                                <Button Content="🎚️ Mở cửa sổ Mini Studio" Click="OpenMiniStudio_Click" Style="{StaticResource FlatGlassBtn}" Height="30" Padding="12,3" Foreground="#00E5FF" FontWeight="SemiBold"
                                        ToolTip="Mở cửa sổ Mini Studio riêng để Cắt, Ghép kéo-thả, Chỉnh Tone, Nhái giọng &amp; lọc 5-Band EQ"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Border Background="#48060C14" CornerRadius="4" BorderBrush="#2EFFFFFF" BorderThickness="1"
                                    IsEnabled="{Binding IsControlsEnabled, FallbackValue=True, TargetNullValue=True}">
                                <Border.Effect>
                                    <BlurEffect Radius="{Binding EditorBlurRadius, FallbackValue=0, TargetNullValue=0}"/>
                                </Border.Effect>
                                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="5000"
                                         Background="Transparent" Foreground="#F5FAFF" CaretBrush="{Binding AccentBrush, FallbackValue=#0078D4}"
                                         BorderThickness="0" Padding="16" FontSize="15"
                                         VerticalScrollBarVisibility="Auto"/>
                            </Border>

                            <Border Background="#99040810" CornerRadius="4"
                                    Visibility="{Binding ProcessingVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                                    IsHitTestVisible="{Binding IsProcessing, FallbackValue=False, TargetNullValue=False}">
                                <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Background="#E60C1422" BorderBrush="{Binding AccentBrush, FallbackValue=#0078D4}" BorderThickness="1"
                                        CornerRadius="5" Padding="24,20">
                                    <StackPanel>
                                        <TextBlock Text="🎙️ ĐANG XỬ LÝ ÂM THANH AI STUDIO..." Foreground="White"
                                                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                        <TextBlock Text="{Binding SynthesisStatusText}" Foreground="#B8D8F8"
                                                   FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                        <Grid Height="20" Margin="0,0,0,6">
                                            <ProgressBar Value="{Binding SynthesisProgress, FallbackValue=0}" Minimum="0" Maximum="100"
                                                         Background="#44000000" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}"
                                                         BorderBrush="#40FFFFFF" BorderThickness="1"/>
                                            <TextBlock Text="{Binding SynthesisProgressPercent, FallbackValue=0%}" Foreground="White"
                                                       FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="Vui lòng đợi trong giây lát, các nút chức năng đang tạm khóa..."
                                                   Foreground="#7898B8" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"
                                    IsEnabled="{Binding IsControlsEnabled, FallbackValue=True}">
                            <Button Content="🗑️ Dọn dẹp Output" Command="{Binding ClearCacheCommand}" Style="{StaticResource FlatGlassBtn}" MinWidth="145" Height="40" Padding="14,6" Margin="0,0,10,0"/>
                            <Button Content="📂 Mở thư mục Output" Command="{Binding OpenFolderCommand}" CommandParameter="Output" Style="{StaticResource FlatGlassBtn}" MinWidth="170" Height="40" Padding="14,6" Margin="0,0,10,0"/>
                            <Button Content="💾 Lưu file .WAV" Command="{Binding SaveCommand}" Style="{StaticResource FlatGlassBtn}" MinWidth="135" Height="40" Padding="14,6" Margin="0,0,10,0"/>
                            <Button Content="▶ CHUYỂN GIỌNG NÓI" Command="{Binding SynthesizeCommand}" Style="{StaticResource FlatPrimaryBtn}" MinWidth="195" Height="40" Padding="18,6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== PANEL DƯỚI: SÓNG ÂM TƯƠNG TÁC 2 VẠCH (CHÍNH & PHỤ) ==================== -->
            <Border Grid.Row="2" Background="#38040810" CornerRadius="0,0,6,6" Padding="14,10"
                    BorderBrush="#30FFFFFF" BorderThickness="0,1,0,0" IsEnabled="{Binding IsControlsEnabled, FallbackValue=True}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="290"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="▶" Command="{Binding PlayCommand}" Style="{StaticResource FlatIconBtn}" Width="40" Height="36" Margin="3"/>
                            <Button Content="⏸" Command="{Binding PauseCommand}" Style="{StaticResource FlatIconBtn}" Width="40" Height="36" Margin="3"/>
                            <Button Content="⏹" Command="{Binding StopCommand}" Style="{StaticResource FlatIconBtn}" Width="40" Height="36" Margin="3"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,8,4,0">
                            <TextBlock Text="🔊" Foreground="#B0C8E0" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="96" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Foreground="#D8ECFF" FontSize="11.5" Width="34" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="10,0,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#40060D18" CornerRadius="3" Padding="10,2" BorderBrush="#28FFFFFF" BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="VẠCH CHÍNH:" Foreground="#90B4D4" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding CurrentTimeText}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="13.5" VerticalAlignment="Center"/>
                                    <TextBlock Text=" / " Foreground="#7090B0" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalTimeText}" Foreground="#C8E0F8" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RemainingTimeText, StringFormat={} ({0})}" Foreground="#80A4C8" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#28FFFFFF" BorderBrush="{Binding SecondaryLineBrush, FallbackValue=#FFD600}" BorderThickness="1" CornerRadius="2" Padding="8,1" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="VẠCH PHỤ: " Foreground="#C8E0F8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding HoverTimeText}" Foreground="{Binding SecondaryLineBrush, FallbackValue=#FFD600}" FontWeight="Bold" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#24FFFFFF" CornerRadius="2" Padding="7,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProgressPercentText}" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="WaveformContainer" Grid.Row="1" Background="#4503070E" CornerRadius="3" Margin="0,5,0,0"
                                BorderBrush="#28FFFFFF" BorderThickness="1" ClipToBounds="True" Cursor="Cross"
                                MouseMove="WaveformContainer_MouseMove"
                                MouseEnter="WaveformContainer_MouseEnter"
                                MouseLeave="WaveformContainer_MouseLeave"
                                MouseLeftButtonDown="WaveformContainer_MouseLeftButtonDown"
                                MouseLeftButtonUp="WaveformContainer_MouseLeftButtonUp"
                                SizeChanged="WaveformContainer_SizeChanged">
                            <Grid>
                                <Line X1="0" Y1="42" X2="2000" Y2="42" Stroke="#18FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>

                                <Viewbox Stretch="Fill" Margin="0,4" IsHitTestVisible="False">
                                    <Polygon Points="{Binding WaveformPoints}" Fill="{Binding WaveformBrush, FallbackValue=#00B4FF}" Opacity="0.88"/>
                                </Viewbox>

                                <Canvas x:Name="TimelineOverlayCanvas" IsHitTestVisible="False">
                                    <Line x:Name="MainPlayheadLine" Y1="0" Y2="120" Stroke="#FF2E54" StrokeThickness="2" Canvas.Left="0"/>

                                    <Line x:Name="SecondaryHoverLine" Y1="0" Y2="120"
                                          Stroke="{Binding SecondaryLineBrush, FallbackValue=#FFD600}" StrokeThickness="1.5"
                                          StrokeDashArray="3,2" Visibility="Collapsed" Canvas.Left="0"/>

                                    <Border x:Name="SecondaryTimePopup" Background="#E60A121E"
                                            BorderBrush="{Binding SecondaryLineBrush, FallbackValue=#FFD600}" BorderThickness="1"
                                            CornerRadius="2" Padding="5,1" Visibility="Collapsed"
                                            Canvas.Top="4" Canvas.Left="0">
                                        <TextBlock Text="{Binding HoverTimeText}" Foreground="{Binding SecondaryLineBrush, FallbackValue=#FFD600}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- KHUNG LỊCH SỬ BẢN GHI DƯỚI ĐÁY (BẤM '🎚️ Sửa' SẼ MỞ CỬA SỔ MINI STUDIO RIÊNG) -->
                    <Border Grid.Column="2" Background="#45050A12" CornerRadius="3" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="2,0,0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="LỊCH SỬ BẢN GHI" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🎚️ Sửa Studio" Click="OpenMiniStudio_Click" Style="{StaticResource MiniChipBtn}" Padding="7,1" FontSize="10.5" Margin="0,0,4,0" Foreground="#00E5FF" ToolTip="Mở cửa sổ Mini Studio để cắt, ghép, chỉnh tone bản ghi này"/>
                                    <Button Content="🗑️ Xoá" Command="{Binding DeleteRecordingCommand}" Style="{StaticResource MiniChipBtn}" Padding="7,1" FontSize="10.5" Foreground="#FF8A80" ToolTip="Xoá bản ghi đang chọn"/>
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" Background="Transparent" Foreground="#E6F2FF" BorderThickness="0"
                                     ItemsSource="{Binding HistoryList}"
                                     SelectedItem="{Binding SelectedHistoryItem}"
                                     DisplayMemberPath="DisplayText"
                                     FontSize="11.5" FontFamily="Consolas"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="ToolTip" Value="{Binding DurationPopupText}"/>
                                        <Setter Property="ToolTipService.InitialShowDelay" Value="60"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>