<Window x:Class="VoiceCraft.MiniStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VoiceCraft - Mini Studio (Ctrl + Lăn Chuột Thu Phóng • Di Chuyển Tự Do • Đa Layer CapCut)"
        Height="860" Width="1440"
        MinHeight="740" MinWidth="1200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Focusable="True" PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown">

    <Border Background="{Binding WindowGlassBrush, FallbackValue=#D912161F}" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding WindowBorderBrush, FallbackValue=#550078D4}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Polygon Grid.Row="0" Grid.RowSpan="2" Points="0,0 620,0 340,860 0,860" IsHitTestVisible="False"
                     Visibility="{Binding AeroReflectionVisibility, FallbackValue=Visible}">
                <Polygon.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#14FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Polygon.Fill>
            </Polygon>

            <!-- THANH TIÊU ĐỀ CỬA SỔ MINI STUDIO -->
            <Border Grid.Row="0" Background="#24000000" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1"
                    CornerRadius="6,6,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="#00E5FF" Margin="0,0,10,0"/>
                        <TextBlock Text="🎚️ VoiceCraft Mini Studio" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <Border Background="#2200E5FF" CornerRadius="3" Padding="10,2" Margin="12,0,0,0" BorderBrush="#4400E5FF" BorderThickness="1">
                            <TextBlock Text="Phím tắt: [Ctrl + Lăn chuột] Thu phóng Timeline • [Giữ Chuột phải / Giữa kéo] Di chuyển tự do • [Ctrl+B / S] Cắt tách • [Space] Phát" Foreground="#B8E8FF" FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button Content="─" Width="46" Style="{StaticResource Win10TitleBtn}" Click="Minimize_Click"/>
                        <Button Content="☐" Width="46" Style="{StaticResource Win10TitleBtn}" Click="Maximize_Click"/>
                        <Button Content="✕" Width="48" Style="{StaticResource Win10CloseBtn}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BỐ CỤC 3 CỘT: TRÁI (CHỈNH EQ/TONE/NHÁI GIỌNG TỪNG THÀNH PHẦN) - GIỮA (TIMELINE N-LAYER THU PHÓNG TỰ DO + SÓNG ÂM TỔNG HỢP DƯỚI) - PHẢI (DANH SÁCH BẢN GHI) -->
            <Grid Grid.Row="1" Margin="12,10,12,12" IsEnabled="{Binding IsControlsEnabled, FallbackValue=True}">
                <Grid.Effect>
                    <BlurEffect Radius="{Binding EditorBlurRadius, FallbackValue=0, TargetNullValue=0}"/>
                </Grid.Effect>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="305"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== 1. CỘT TRÁI: CHỈNH EQ, TONE & NHÁI GIỌNG CHO THÀNH PHẦN ĐANG CHỌN ==================== -->
                <Border Grid.Column="0" Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="5" Padding="14,12" Margin="0,0,10,0"
                        BorderBrush="#30FFFFFF" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="🛠️ CHỈNH SỬA THÀNH PHẦN ĐANG CHỌN" Foreground="#00E5FF" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>

                            <Border Background="#24102038" BorderBrush="#5500E5FF" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,10">
                                <TextBlock Text="{Binding SelectedClipInspectorTitle}" Foreground="#FFF59D" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>

                            <!-- BỘ LỌC 5-BAND EQ (ĐỔI MÀU NỀN CLIP KHI CHỈNH EQ) -->
                            <Border Background="#2D142C" BorderBrush="#77E040FB" BorderThickness="1.2" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎚️ 1. CHỈNH TẦN SỐ EQ (ĐỔI MÀU CLIP)" Foreground="#EA80FC" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="↺ Mặc định (0dB)" Command="{Binding ResetStudioEqCommand}" Style="{StaticResource MiniChipBtn}" Padding="8,2"/>
                                    </Grid>

                                    <TextBlock Text="💡 Khi chỉnh EQ, màu nền của thành phần trên Layer sẽ tự động đổi sang màu Tím Hồng để đánh dấu đã chỉnh EQ."
                                               Foreground="#CE93D8" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1. Siêu trầm (Sub-Bass 80 Hz):" Foreground="#E6F2FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioBand80Hz, StringFormat={}{0:0.0} dB}" Foreground="#00E676" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding StudioBand80Hz}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="2. Độ ấm ngực (Warmth 220 Hz):" Foreground="#E6F2FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioBand220Hz, StringFormat={}{0:0.0} dB}" Foreground="#00E676" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding StudioBand220Hz}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="3. Trung âm (Mid 1000 Hz):" Foreground="#E6F2FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioBand1kHz, StringFormat={}{0:0.0} dB}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding StudioBand1kHz}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="4. Độ rõ chữ (Presence 3.5 kHz):" Foreground="#E6F2FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioBand3k5Hz, StringFormat={}{0:0.0} dB}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding StudioBand3k5Hz}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="5. Độ thoáng (Air Treble 8 kHz):" Foreground="#E6F2FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioBand8kHz, StringFormat={}{0:0.0} dB}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding StudioBand8kHz}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Cắt ù trầm (Highpass Hz):" Foreground="#B8E8FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioHighpassHz, StringFormat={}{0:0} Hz}" Foreground="#FFD600" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="20" Maximum="250" Value="{Binding StudioHighpassHz}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>

                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Khử sôi nền (Lowpass Hz):" Foreground="#B8E8FF" FontSize="11"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioLowpassHz, StringFormat={}{0:0} Hz}" Foreground="#FFD600" FontWeight="Bold" FontFamily="Consolas" FontSize="11"/>
                                    </Grid>
                                    <Slider Minimum="4000" Maximum="12000" Value="{Binding StudioLowpassHz}" TickFrequency="250" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>

                            <!-- CHỈNH TONE & TỐC ĐỘ -->
                            <Border Background="#280D1420" BorderBrush="#38A855F7" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🎵 2. CHỈNH TONE &amp; TỐC ĐỘ CLIP" Foreground="#C084FC" FontWeight="Bold" FontSize="11.5" Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Chỉnh Tone (Bán âm Semitones):" Foreground="#E6F2FF" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioSemitonesDisplay}" Foreground="#FFD600" FontWeight="Bold" FontFamily="Consolas" FontSize="12"/>
                                    </Grid>
                                    <Slider Minimum="-12.0" Maximum="12.0" Value="{Binding StudioSemitones}" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,0,0,6"/>

                                    <UniformGrid Rows="1" Columns="5" Margin="0,0,0,10">
                                        <Button Content="-4" Command="{Binding SetStudioSemitonePresetCommand}" CommandParameter="-4" Style="{StaticResource MiniChipBtn}" Height="24"/>
                                        <Button Content="-2" Command="{Binding SetStudioSemitonePresetCommand}" CommandParameter="-2" Style="{StaticResource MiniChipBtn}" Height="24"/>
                                        <Button Content="0 (Gốc)" Command="{Binding SetStudioSemitonePresetCommand}" CommandParameter="0" Style="{StaticResource MiniChipBtn}" Height="24"/>
                                        <Button Content="+2" Command="{Binding SetStudioSemitonePresetCommand}" CommandParameter="2" Style="{StaticResource MiniChipBtn}" Height="24"/>
                                        <Button Content="+4" Command="{Binding SetStudioSemitonePresetCommand}" CommandParameter="4" Style="{StaticResource MiniChipBtn}" Height="24"/>
                                    </UniformGrid>

                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Tốc độ đoạn (Speed):" Foreground="#E6F2FF" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioSpeed, StringFormat={}{0:0.0#}x}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="12"/>
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="2.0" Value="{Binding StudioSpeed}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>

                            <!-- NHÁI GIỌNG AI LÊN CLIP ĐANG CHỌN -->
                            <Border Background="#280A1828" BorderBrush="#4400E5FF" BorderThickness="1" CornerRadius="5" Padding="12,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🧬 3. ÁP DỤNG NHÁI GIỌNG MẪU" Foreground="#00E5FF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding StudioCloneEnabled}" Content="Bật" Foreground="#FFF59D" FontWeight="SemiBold"/>
                                    </Grid>

                                    <TextBlock Text="{Binding CloneReferenceFileName}" Foreground="#B8E8FF" FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📂 Chọn mẫu giọng (.wav/.mp3)" Command="{Binding SelectCloneSampleCommand}" Style="{StaticResource MiniChipBtn}" Height="26" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="▶ Nghe mẫu" Command="{Binding PreviewCloneSampleCommand}" Style="{StaticResource MiniChipBtn}" Height="26" Padding="8,2"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Độ khớp giọng mẫu (Strength):" Foreground="#D8ECFF" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StudioCloneStrength, StringFormat={}{0:P0}}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                    </Grid>
                                    <Slider Minimum="0.0" Maximum="1.0" Value="{Binding StudioCloneStrength}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ==================== 2. KHU VỰC GIỮA: CỬA SỔ LAYER THU PHÓNG & DI CHUYỂN TỰ DO Ở TRÊN + SÓNG ÂM TỔNG HỢP Ở DƯỚI ==================== -->
                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <!-- A. BÀN DỰNG TIMELINE ĐA LAYER ĐỘNG (HỖ TRỢ CTRL + LĂN CHUỘT THU PHÓNG & KÉO DI CHUYỂN TỰ DO) -->
                    <Border Grid.Row="0" Background="#45040811" CornerRadius="5" Margin="0,0,0,10" BorderBrush="#4000E5FF" BorderThickness="1.5" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Thanh công cụ điều khiển Layer, Chế độ Di chuyển khung nhìn (Pan) & Thu phóng -->
                            <Border Grid.Row="0" Background="#40081220" Padding="8,4" BorderBrush="#28FFFFFF" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="➕ Thêm Layer" Click="AddLayerButton_Click" Style="{StaticResource FlatPrimaryBtn}" Height="26" Padding="9,2" Margin="0,0,5,0" FontSize="11" ToolTip="Thêm Layer mới (Layer 2, Layer 3, Layer 4...)"/>
                                        <Button x:Name="HandPanModeBtn" Content="✋ Kéo khung nhìn: Tắt" Click="HandPanModeBtn_Click" Style="{StaticResource MiniChipBtn}" Height="26" Padding="8,2" Margin="0,0,5,0" Foreground="#80D8FF" ToolTip="Bật chế độ nắm kéo khung nhìn tự do bằng chuột trái (Hoặc giữ Chuột phải / Chuột giữa / phím Alt để kéo bất kỳ lúc nào)"/>
                                        <Button Content="✂️ Tách (Ctrl+B)" Click="SplitClipButton_Click" Style="{StaticResource MiniChipBtn}" Height="26" Padding="8,2" Margin="0,0,5,0" Foreground="#FFF59D" FontWeight="SemiBold"/>
                                        <Button Content="📋 Copy" Click="CopyClipButton_Click" Style="{StaticResource MiniChipBtn}" Height="26" Padding="7,2" Margin="0,0,4,0"/>
                                        <Button Content="📌 Paste" Click="PasteClipButton_Click" Style="{StaticResource MiniChipBtn}" Height="26" Padding="7,2" Margin="0,0,4,0"/>
                                        <Button Content="🗑️ Xoá" Click="DeleteClipButton_Click" Style="{StaticResource MiniChipBtn}" Height="26" Padding="7,2" Margin="0,0,4,0" Foreground="#FF8A80"/>
                                        <Button Content="🧹 Xoá hết" Click="ClearAllTimelineButton_Click" Style="{StaticResource MiniChipBtn}" Height="26" Padding="7,2"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🔲 Vừa khung" Click="ZoomFitButton_Click" Style="{StaticResource MiniChipBtn}" Height="24" Padding="7,2" Margin="0,0,5,0" Foreground="#00E676" ToolTip="Tự động thu phóng để thấy trọn vẹn toàn bộ các thành phần dài trên Timeline"/>
                                        <Button Content="➖" Click="ZoomOutButton_Click" Style="{StaticResource MiniChipBtn}" Width="24" Height="24" Margin="0,0,4,0" ToolTip="Thu nhỏ Timeline (Ctrl + Lăn chuột xuống)"/>
                                        <Slider x:Name="TimelineZoomSlider" Minimum="1.5" Maximum="300" Value="60" Width="90" VerticalAlignment="Center" ValueChanged="TimelineZoomSlider_ValueChanged" ToolTip="Thu phóng Timeline (Hoặc giữ Ctrl + Lăn chuột trực tiếp trên Layer)"/>
                                        <Button Content="➕" Click="ZoomInButton_Click" Style="{StaticResource MiniChipBtn}" Width="24" Height="24" Margin="4,0,6,0" ToolTip="Phóng to Timeline (Ctrl + Lăn chuột lên)"/>
                                        <TextBlock x:Name="ZoomLevelText" Text="60 px/s" Foreground="#00E5FF" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Width="54" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Vùng hiển thị danh sách Layer động và mặt phẳng kéo thả Clip -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cột nhãn tên các Layer bên trái -->
                                <Grid Grid.Column="0" Background="#55060C16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#400A1424" BorderBrush="#28FFFFFF" BorderThickness="0,0,1,1" Padding="8,0">
                                        <TextBlock Text="⏱️ THƯỚC GIÂY" Foreground="#90B4D4" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>
                                    </Border>
                                    <ScrollViewer x:Name="LayerHeadersScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                                        <StackPanel x:Name="LayerHeadersStack"/>
                                    </ScrollViewer>
                                </Grid>

                                <!-- Mặt phẳng Timeline Đa Layer hỗ trợ Ctrl + Lăn chuột & Kéo di chuyển tự do -->
                                <Grid Grid.Column="1" Background="#3502050A">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Thước thời gian cố định phía trên, cuộn ngang theo Timeline -->
                                    <ScrollViewer x:Name="RulerScrollViewer" Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                                        <Canvas x:Name="TimeRulerCanvas" Height="28" Width="2400" Background="#450A1424" Cursor="Hand"
                                                MouseLeftButtonDown="TimeRulerCanvas_MouseLeftButtonDown"
                                                MouseMove="TimeRulerCanvas_MouseMove"
                                                MouseLeftButtonUp="TimeRulerCanvas_MouseLeftButtonUp"/>
                                    </ScrollViewer>

                                    <!-- Vùng cuộn 2 chiều chứa các dòng Layer 1, 2, 3, 4... -->
                                    <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                                  ScrollChanged="TimelineScrollViewer_ScrollChanged"
                                                  PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel">
                                        <Grid x:Name="CapCutTrackSurface" Width="2400" MinHeight="220" VerticalAlignment="Top"
                                              AllowDrop="True" Background="Transparent"
                                              DragEnter="CapCutTrackSurface_DragEnter"
                                              DragOver="CapCutTrackSurface_DragOver"
                                              DragLeave="CapCutTrackSurface_DragLeave"
                                              Drop="CapCutTrackSurface_Drop"
                                              MouseDown="CapCutTrackSurface_MouseDown"
                                              MouseUp="CapCutTrackSurface_MouseUp"
                                              MouseLeftButtonDown="CapCutTrackSurface_MouseLeftButtonDown"
                                              MouseMove="CapCutTrackSurface_MouseMove"
                                              MouseLeftButtonUp="CapCutTrackSurface_MouseLeftButtonUp"
                                              MouseRightButtonDown="CapCutTrackSurface_MouseRightButtonDown">

                                            <Canvas x:Name="LayerLanesBackgroundCanvas" IsHitTestVisible="False"/>
                                            <Canvas x:Name="CapCutClipsCanvas"/>

                                            <Canvas x:Name="CapCutPlayheadCanvas" IsHitTestVisible="False">
                                                <Line x:Name="CapCutHoverLine" Y1="0" Y2="800" Stroke="#88FFD600" StrokeThickness="1.2" StrokeDashArray="3,2" Visibility="Collapsed" Canvas.Left="0"/>
                                                <Line x:Name="CapCutPlayheadLine" Y1="0" Y2="800" Stroke="#FF2E54" StrokeThickness="2" Canvas.Left="0"/>
                                                <Polygon x:Name="CapCutPlayheadHead" Points="-7,0 7,0 7,9 0,15 -7,9" Fill="#FF2E54" Canvas.Left="0" Canvas.Top="0"/>
                                            </Canvas>

                                            <Border x:Name="DropMergeHighlightOverlay" Background="#3800E676" BorderBrush="#00E676" BorderThickness="2" CornerRadius="4"
                                                    Visibility="Collapsed" IsHitTestVisible="False">
                                                <Border Background="#E606121E" CornerRadius="5" Padding="18,10" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#00E676" BorderThickness="1">
                                                    <TextBlock Text="🎬 THẢ BẢN GHI VÀO DÒNG LAYER HOẶC THẢ XUỐNG DƯỚI ĐỂ TỰ TẠO LAYER MỚI!" Foreground="#00E676" FontWeight="Bold" FontSize="13"/>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- B. PHÍA DƯỚI: TRÌNH PHÁT TỔNG HỢP CỦA CÁC LAYER & HIỂN THỊ SÓNG ÂM TỔNG HỢP KÈM ĐỘ DÀI -->
                    <Border Grid.Row="1" Background="#48040914" CornerRadius="5" BorderBrush="#5500E676" BorderThickness="1.5" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>

                            <!-- Tiêu đề Sóng âm tổng hợp & Độ dài tổng hợp của tất cả các Layer -->
                            <Border Grid.Row="0" Background="#45081426" CornerRadius="4" Padding="10,3" BorderBrush="#30FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🌊 SÓNG ÂM TỔNG HỢP CÁC LAYER (MASTER COMPOSITE): " Foreground="#00E676" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Text="{Binding StudioMasterSummaryText}" Foreground="White" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#2800E676" BorderBrush="#8800E676" BorderThickness="1" CornerRadius="3" Padding="8,1" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding TotalTimeText, StringFormat=ĐỘ DÀI TỔNG HỢP: {0}}" Foreground="#00E676" FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"/>
                                        </Border>
                                        <TextBlock Text="VẠCH PHÁT: " Foreground="#90B4D4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentTimeText}" Foreground="#FF5252" FontWeight="Bold" FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBlock Text=" / " Foreground="#7090B0" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalTimeText}" Foreground="#E0F7FA" FontWeight="Bold" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Khung hiển thị Sóng âm Tổng hợp của toàn bộ các Layer -->
                            <Border x:Name="StudioWaveformStage" Grid.Row="1" Background="#5502050B" CornerRadius="4" Margin="0,6,0,6"
                                    BorderBrush="#3500E676" BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                                    MouseLeftButtonDown="StudioWaveformStage_MouseLeftButtonDown"
                                    MouseMove="StudioWaveformStage_MouseMove"
                                    SizeChanged="StudioWaveformStage_SizeChanged">
                                <Grid>
                                    <Line x:Name="CenterZeroLine" X1="0" Y1="50" X2="2500" Y2="50" Stroke="#24FFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                                    <Viewbox Stretch="Fill" Margin="0,6" IsHitTestVisible="False">
                                        <Polygon Points="{Binding StudioMasterWaveformPoints}" Fill="#00E676" Opacity="0.88"/>
                                    </Viewbox>
                                    <Canvas x:Name="StudioOverlayCanvas" IsHitTestVisible="False">
                                        <Line x:Name="StudioMainPlayhead" Y1="0" Y2="160" Stroke="#FF2E54" StrokeThickness="2.2" Canvas.Left="0"/>
                                    </Canvas>
                                </Grid>
                            </Border>

                            <!-- Thanh điều khiển Trình phát Tổng hợp & Xuất file -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶ Phát tổng hợp" Click="MasterPlayButton_Click" Style="{StaticResource FlatPrimaryBtn}" Height="34" Padding="14,4" Margin="0,0,5,0" FontWeight="Bold"/>
                                    <Button Content="⏸" Command="{Binding PauseCommand}" Style="{StaticResource FlatIconBtn}" Width="34" Height="34" Margin="0,0,5,0"/>
                                    <Button Content="⏹" Command="{Binding StopCommand}" Style="{StaticResource FlatIconBtn}" Width="34" Height="34" Margin="0,0,10,0"/>
                                    <TextBlock Text="🔊" Foreground="#B0C8E0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider Minimum="0" Maximum="100" Value="{Binding Volume}" Width="80" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding StudioStatusText}" Foreground="#B8E8FF" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,10,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="↺ Đặt lại DSP đoạn chọn" Command="{Binding ResetStudioAllCommand}" Style="{StaticResource FlatGlassBtn}" Height="34" Padding="12,4" Margin="0,0,8,0"/>
                                    <Button Content="✨ XUẤT FILE TỔNG HỢP (.WAV)" Command="{Binding RenderCapCutTimelineMixdownCommand}" Style="{StaticResource FlatPrimaryBtn}" Height="34" Padding="16,4" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== 3. CỘT PHẢI: KHO BẢN GHI ==================== -->
                <Border Grid.Column="2" Background="{Binding CardGlassBrush, FallbackValue=#73090E17}" CornerRadius="5" Padding="12,12"
                        BorderBrush="#30FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📂 DANH SÁCH BẢN GHI" Foreground="#00E5FF" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="🔄 Quét lại" Command="{Binding ScanRecordingsCommand}" Style="{StaticResource MiniChipBtn}" Padding="8,3"/>
                        </Grid>

                        <Border Grid.Row="1" Background="#2200C8FF" BorderBrush="#4400C8FF" BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                            <TextBlock Text="🖱️ Ctrl + Lăn chuột trên Layer để thu phóng • Giữ Chuột phải / Giữa kéo để di chuyển khung nhìn tự do!"
                                       Foreground="#B8E8FF" FontSize="11" TextWrapping="Wrap"/>
                        </Border>

                        <Border Grid.Row="2" Background="#4503070D" CornerRadius="4" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="4">
                            <ListBox x:Name="StudioRecordingsListBox" Background="Transparent" Foreground="#E6F2FF" BorderThickness="0"
                                     ItemsSource="{Binding HistoryList}"
                                     SelectedItem="{Binding SelectedHistoryItem}"
                                     DisplayMemberPath="DisplayText"
                                     FontSize="11.5" FontFamily="Consolas"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                     PreviewMouseLeftButtonDown="StudioRecordingsListBox_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="StudioRecordingsListBox_PreviewMouseMove">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="6,5"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ToolTip" Value="{Binding DurationPopupText}"/>
                                        <Setter Property="ToolTipService.InitialShowDelay" Value="60"/>
                                        <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>

                        <UniformGrid Grid.Row="3" Columns="2" Rows="1" Height="32" Margin="0,8,0,6">
                            <Button Content="➕ Vào Layer hiện tại" Click="AddRecordingToCurrentLayer_Click" Style="{StaticResource FlatGlassBtn}" Margin="0,0,4,0" FontSize="11" ToolTip="Nối bản ghi đang chọn vào dòng Layer hiện tại"/>
                            <Button Content="➕ Thành Layer mới" Click="AddRecordingAsNewLayer_Click" Style="{StaticResource FlatPrimaryBtn}" Margin="4,0,0,0" FontSize="11" ToolTip="Tạo thêm dòng Layer mới (Layer 2, 3, 4...) và đặt bản ghi này vào đó"/>
                        </UniformGrid>

                        <UniformGrid Grid.Row="4" Columns="2" Rows="1" Height="32">
                            <Button Content="🗑️ Xoá bản ghi" Command="{Binding DeleteRecordingCommand}" Style="{StaticResource FlatGlassBtn}" Margin="0,0,4,0" Foreground="#FF8A80" FontSize="11"/>
                            <Button Content="📂 Thư mục Output" Command="{Binding OpenFolderCommand}" CommandParameter="Output" Style="{StaticResource FlatGlassBtn}" Margin="4,0,0,0" FontSize="11"/>
                        </UniformGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- OVERLAY ĐANG XUẤT FILE ĐÃ CHỈNH SỬA (GIAO DIỆN Y HỆT LÚC CHUYỂN VĂN BẢN THÀNH GIỌNG NÓI) -->
            <Border Grid.Row="1" Background="#99040810" CornerRadius="5" Margin="12,10,12,12"
                    Visibility="{Binding ProcessingVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}"
                    IsHitTestVisible="{Binding IsProcessing, FallbackValue=False, TargetNullValue=False}">
                <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#E60C1422" BorderBrush="{Binding AccentBrush, FallbackValue=#0078D4}" BorderThickness="1"
                        CornerRadius="5" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="🎙️ ĐANG XỬ LÝ ÂM THANH AI STUDIO..." Foreground="White"
                                   FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                        <TextBlock Text="{Binding SynthesisStatusText}" Foreground="#B8D8F8"
                                   FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <Grid Height="20" Margin="0,0,0,6">
                            <ProgressBar Value="{Binding SynthesisProgress, FallbackValue=0}" Minimum="0" Maximum="100"
                                         Background="#44000000" Foreground="{Binding AccentBrush, FallbackValue=#0078D4}"
                                         BorderBrush="#40FFFFFF" BorderThickness="1"/>
                            <TextBlock Text="{Binding SynthesisProgressPercent, FallbackValue=0%}" Foreground="White"
                                       FontWeight="Bold" FontFamily="Consolas" FontSize="11.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Vui lòng đợi trong giây lát, các nút chức năng đang tạm khóa..."
                                   Foreground="#7898B8" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>